# Public URL of the portal (behind your TLS reverse proxy). Register
# <WOLP_BASE_URL>/auth/callback as redirect URI at the identity provider.
WOLP_BASE_URL=https://wol.example.com
WOLP_LISTEN=:8080

# No trailing slash: it must match the "issuer" in the provider's discovery document exactly
WOLP_OIDC_ISSUER=https://idp.example.com/realms/main
WOLP_OIDC_CLIENT_ID=wol-portal
WOLP_OIDC_CLIENT_SECRET=change-me
# WOLP_OIDC_SCOPES=openid,profile,email
WOLP_GROUPS_CLAIM=groups
WOLP_ALLOWED_GROUPS=staadmins
# Optional: only these groups may power hosts on/off (others are view-only)
# WOLP_ADMIN_GROUPS=wol-admins

# At least 32 random bytes, e.g. `openssl rand -base64 48`
WOLP_SESSION_SECRET=

# Broadcast address of the hosts' subnet
WOLP_WOL_BROADCAST=192.168.1.255:9

# SSH
# WOLP_SSH_DEFAULT_USER=wol-portal
# WOLP_SSH_TIMEOUT=15s
# Testing only:
# WOLP_SSH_INSECURE_HOSTKEY=true

# WOLP_PROBE_INTERVAL=5s
# WOLP_PENDING_TIMEOUT=10m
# WOLP_SESSION_TTL=8h
